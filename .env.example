# --- Required -----------------------------------------------------------------
ALPACA_API_KEY=your_key_id_here
ALPACA_SECRET_KEY=your_secret_here

# --- News stream ---------------------------------------------------------------
#ALPACA_NEWS_STREAM_URL=wss://stream.data.alpaca.markets/v1beta1/news
#NEWS_SUBSCRIPTION_MODE=wildcard
#NEWS_FALLBACK_SYMBOLS=
#NEWS_INTEREST_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
#NEWS_IDLE_RECONNECT_SECONDS=0

# --- Stock market-data stream ----------------------------------------------------
#ENABLE_STOCK_STREAM=true
#ALPACA_STOCK_FEED=sip
# Point at wss://stream.data.alpaca.markets/v2/test for credential-free smoke tests
#ALPACA_STOCK_STREAM_URL=
#STOCK_STREAM_CODEC=msgpack
#STOCK_WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
#STOCK_CHANNELS=trades,quotes,bars,updatedBars,dailyBars,statuses,lulds
#STOCK_IDLE_RECONNECT_SECONDS=120
#STOCK_QUOTE_SAMPLE_MS=0
#STOCK_TICK_RETENTION_MINUTES=240
#STOCK_BAR_RETENTION_DAYS=30
#MARKET_STORAGE_PATH=/data/alpaca_market.sqlite

# --- REST ------------------------------------------------------------------------
#ALPACA_DATA_BASE_URL=https://data.alpaca.markets
#ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
#ENABLE_REST_BACKFILL=true
#BACKFILL_LOOKBACK_MINUTES=60

# --- Alerts ------------------------------------------------------------------------
#ALERT_KEYWORDS_FILE=
#ALERT_RATE_LIMIT_PER_SYMBOL_HOUR=10
#HALT_ALERT_DEDUP_SECONDS=300

# --- Server --------------------------------------------------------------------------
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
#LOG_LEVEL=info
#STORAGE_PATH=/data/alpaca_news.sqlite
